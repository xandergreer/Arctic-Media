<?xml version="1.0" encoding="UTF-8"?>
<component name="SeasonPage" extends="Group">
    <interface>
        <field id="navRequest"   type="assocarray" alwaysNotify="true" />
        <field id="params"       type="assocarray" />
        <field id="restoreFocus" type="boolean"    alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/SeasonPage.brs" />
    <children>
        <!-- ═══ Backdrop + scrim ═══
             The backdrop follows the focused episode's artwork; the scrim keeps
             card text readable over busy frames. -->
        <Rectangle color="0x06060FFF" width="1920" height="1080" />
        <Poster id="backdrop" width="1920" height="1080" opacity="0.20"
                loadDisplayMode="scaleToZoom" />
        <Rectangle color="0x06060FCC" width="1920" height="1080" />

        <!-- ═══ Header ═══ -->
        <Label id="showTitle" translation="[96, 58]" width="1500"
               font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="seasonInfo" translation="[96, 120]" width="900"
               font="font:SmallBoldSystemFont" color="0x7FA6D8FF" />
        <Rectangle color="0x5AA9FFFF" width="64" height="4" translation="[96, 160]" />

        <!-- ═══ SEASONS rail ═══ -->
        <Label translation="[96, 198]" text="SEASONS"
               color="0x7FA6D8FF" font="font:SmallBoldSystemFont" width="240" />
        <LabelList id="seasonList"
                   translation="[96, 246]"
                   itemSize="[270, 60]"
                   itemSpacing="[0, 6]"
                   numRows="10"
                   focusBitmapUri=""
                   focusedColor="0x5AA9FFFF"
                   color="0xC2CEE2FF"
                   font="font:MediumSystemFont"
                   focusedFont="font:MediumBoldSystemFont" />

        <Rectangle translation="[414, 198]" width="2" height="760" color="0x1C2C4AFF" />

        <!-- ═══ EPISODE cards ═══ -->
        <MarkupGrid id="episodeGrid"
                    translation="[456, 200]"
                    itemComponentName="EpisodeCard"
                    itemSize="[1384, 176]"
                    itemSpacing="[0, 16]"
                    numColumns="1"
                    numRows="4"
                    drawFocusFeedback="false"
                    vertFocusAnimationStyle="floatingFocus" />

        <!-- Hint — kept inside the action-safe area (bottom limit ≈1027) -->
        <Label translation="[96, 992]" width="1400"
               text="Left/Right = switch column     OK = play     Back = return"
               color="0x5A6478FF" font="font:SmallSystemFont" />
    </children>
</component>
