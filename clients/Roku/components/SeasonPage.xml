<?xml version="1.0" encoding="UTF-8"?>
<component name="SeasonPage" extends="Group">
    <interface>
        <field id="navRequest"   type="assocarray" alwaysNotify="true" />
        <field id="params"       type="assocarray" />
        <field id="restoreFocus" type="boolean"    alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/SeasonPage.brs" />
    <children>
        <!-- ═══ Backdrop + scrim ═══
             The backdrop follows the focused episode's artwork; the scrim keeps
             card text readable over busy frames. -->
        <Rectangle color="0x06060FFF" width="1920" height="1080" />
        <Poster id="backdrop" width="1920" height="1080" opacity="0.20"
                loadDisplayMode="scaleToZoom" />
        <Rectangle color="0x06060FCC" width="1920" height="1080" />

        <!-- ═══ Header ═══ -->
        <Label id="showTitle" translation="[80, 48]" width="1500"
               font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="seasonInfo" translation="[80, 120]" width="900"
               font="font:SmallBoldSystemFont" color="0x6F97C8FF" />
        <Rectangle color="0x4A9FFFFF" width="64" height="4" translation="[80, 160]" />

        <!-- ═══ SEASONS rail ═══ -->
        <Label translation="[80, 198]" text="SEASONS"
               color="0x6F97C8FF" font="font:SmallBoldSystemFont" width="240" />
        <LabelList id="seasonList"
                   translation="[80, 246]"
                   itemSize="[270, 60]"
                   itemSpacing="[0, 6]"
                   focusBitmapUri=""
                   focusedColor="0x4A9FFFFF"
                   color="0xB9C6DAFF"
                   font="font:MediumSystemFont"
                   focusedFont="font:MediumBoldSystemFont" />

        <Rectangle translation="[398, 198]" width="2" height="760" color="0x1C2C4AFF" />

        <!-- ═══ EPISODE cards ═══ -->
        <MarkupGrid id="episodeGrid"
                    translation="[440, 200]"
                    itemComponentName="EpisodeCard"
                    itemSize="[1420, 176]"
                    itemSpacing="[0, 16]"
                    numColumns="1"
                    numRows="4"
                    drawFocusFeedback="false"
                    vertFocusAnimationStyle="floatingFocus" />

        <!-- Hint — kept inside the action-safe area (bottom limit ≈1027) -->
        <Label translation="[80, 1000]" width="1400"
               text="Left/Right = switch column     OK = play     Back = return"
               color="0x44557AFF" font="font:SmallSystemFont" />
    </children>
</component>
