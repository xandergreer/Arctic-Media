<?xml version="1.0" encoding="UTF-8"?>
<component name="EpisodeCard" extends="Group">
    <interface>
        <field id="width"        type="float"   value="1384" />
        <field id="height"       type="float"   value="176" />
        <field id="itemContent"  type="node"    onChange="onContentChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/EpisodeCard.brs" />
    <children>
        <Poster id="bg" uri="pkg:/images/row_r10.9.png" width="1384" height="176" />
        

        <Poster id="thumb" translation="[16, 7]" width="288" height="162"
                loadDisplayMode="scaleToZoom" />
        <!-- Watch-progress bar sits on the bottom edge of the thumbnail -->
        <Rectangle id="progTrack" translation="[16, 161]" width="288" height="8"
                   color="0x000000B4" visible="false" />
        <Rectangle id="progFill"  translation="[16, 161]" width="0" height="8"
                   color="0x5AA9FFFF" visible="false" />
        <Poster uri="pkg:/images/corner_thumb.png" translation="[16, 7]" width="288" height="162" />

        <Label id="titleLbl" translation="[336, 20]" width="1032"
               font="font:MediumBoldSystemFont" color="0xE6EDF7FF" />
        <Label id="metaLbl" translation="[336, 64]" width="1032"
               font="font:SmallBoldSystemFont" color="0x7FA6D8FF" />
        <Label id="ovLbl" translation="[336, 98]" width="1032"
               font="font:SmallSystemFont" color="0x9FB0C9FF"
               wrap="true" numLines="2" />
        <Poster id="focusRing" uri="pkg:/images/ring_r12.9.png"
                width="1384" height="176" opacity="0" />
    </children>
</component>
