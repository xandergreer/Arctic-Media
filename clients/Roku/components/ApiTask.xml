<?xml version="1.0" encoding="UTF-8"?>
<component name="ApiTask" extends="Task">
    <interface>
        <field id="url"       type="string" />
        <field id="method"    type="string" value="GET" />
        <field id="token"     type="string" />
        <field id="reqBody"   type="string" />
        <!-- Defaults to JSON. /api/v1/auth/token takes an
             OAuth2PasswordRequestForm, which FastAPI only reads from
             application/x-www-form-urlencoded. -->
        <field id="contentType" type="string" value="application/json" />
        <!-- Set this instead of reqBody to POST a form. The task percent-encodes
             and joins the pairs itself, because roUrlTransfer (and so Escape())
             cannot be created on the render thread — only here. -->
        <field id="formFields" type="assocarray" />
        <field id="result"    type="assocarray" alwaysNotify="true" />
        <field id="resultArr" type="array"      alwaysNotify="true" />
        <field id="apiError"  type="string"     alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
