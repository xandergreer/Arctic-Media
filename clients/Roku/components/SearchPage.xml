<?xml version="1.0" encoding="UTF-8"?>
<component name="SearchPage" extends="Group">
    <interface>
        <field id="navRequest"   type="assocarray" alwaysNotify="true" />
        <field id="params"       type="assocarray" />
        <field id="restoreFocus" type="boolean"    alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/SearchPage.brs" />
    <children>
        <!-- Background -->
        <Rectangle color="0x06060FFF" width="1920" height="1080" />

        <!-- Header bar -->
        <Rectangle color="0x0E0E28FF" width="1920" height="108" />
        <Rectangle color="0x4A9FFF33" width="1920" height="2" translation="[0, 108]" />
        <Label translation="[60, 32]" text="Arctic Media" color="0x4A9FFFFF"
               font="font:MediumBoldSystemFont" width="300" />
        <Label translation="[380, 38]" text="Search" color="0xFFFFFFFF"
               font="font:SmallBoldSystemFont" width="200" />

        <!-- ═══ LEFT: compact keyboard ═══ -->
        <Rectangle color="0x0A0A1AF7" width="700" height="972" translation="[0, 108]" />
        <Rectangle color="0x4A9FFF26" width="2" height="972" translation="[700, 108]" />
        <MiniKeyboard id="keyboard" translation="[92, 210]" />

        <!-- ═══ RIGHT: results ═══ -->
        <Label id="hintLabel" translation="[760, 500]"
               text="Type to search your library"
               color="0x3A4A66FF" font="font:MediumSystemFont"
               width="1100" horizAlign="center" />

        <Label id="noResultsLabel" translation="[760, 500]"
               text="No results found"
               color="0x6F97C8FF" font="font:MediumSystemFont"
               width="1100" horizAlign="center" visible="false" />

        <Label id="resultsHeader" translation="[760, 150]" text="RESULTS"
               color="0x6F97C8FF" font="font:SmallBoldSystemFont"
               width="600" visible="false" />

        <!-- MarkupGrid is focusable (unlike a plain Group), so it can take key
             focus off the keyboard and handle arrow-nav + OK selection. -->
        <MarkupGrid id="resultsGrid" translation="[760, 192]"
                    itemComponentName="PosterItem"
                    itemSize="[182, 270]"
                    numColumns="5" numRows="2"
                    itemSpacing="[36, 52]"
                    vertical="true"
                    drawFocusFeedback="false"
                    focusBitmapUri=""
                    visible="false" />

        <!-- Footer hints -->
        <Label id="kbHint" translation="[60, 1000]"
               text="Back = exit     * = browse results"
               color="0x44557AFF" font="font:SmallSystemFont" width="620" />
        <Label id="resHint" translation="[760, 1000]"
               text="* = back to keyboard     Arrows = browse     OK = open"
               color="0x44557AFF" font="font:SmallSystemFont" width="1100" visible="false" />
    </children>
</component>
