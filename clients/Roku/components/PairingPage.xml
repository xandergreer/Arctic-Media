<?xml version="1.0" encoding="UTF-8"?>
<component name="PairingPage" extends="Group">
    <interface>
        <field id="navRequest" type="assocarray" alwaysNotify="true" />
        <field id="params"     type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/PairingPage.brs" />
    <children>

        <!-- ═══ Cinematic backdrop ═══ -->
        <Poster id="bg" uri="pkg:/images/bg_pairing.png" width="1920" height="1080" translation="[0,0]" />

        <!-- Wordmark (shown on every view) -->
        <Label id="wordmark"
               translation="[0, 300]" width="1920" horizAlign="center"
               text="❄  ARCTIC MEDIA"
               font="font:LargeBoldSystemFont" color="0xEAF3FFFF" />

        <!-- ═══ SETUP VIEW — connect to server ═══ -->
        <Group id="setupView" visible="false">
            <Label translation="[0, 392]" width="1920" horizAlign="center"
                   text="Your library. Every screen."
                   font="font:MediumSystemFont" color="0x7FA6D8FF" />

            <!-- Two ways in. Browser pairing stays first and is the
                 recommended path: it is far less painful than typing a
                 password on a D-pad, and the password never touches the TV.
                 Credential sign-in is the alternative for people who would
                 rather just type it, and it is the only path an automated
                 certification script can drive. -->
            <Poster id="connectCard" uri="pkg:/images/surface_focus_r14.9.png"
                    translation="[700, 496]" width="520" height="96" />
            <Label id="connectLabel"
                   translation="[700, 522]" width="520" horizAlign="center"
                   text="▶   Connect to Server"
                   font="font:MediumBoldSystemFont" color="0xEAF3FFFF" />

            <Poster id="credsCard" uri="pkg:/images/surface_r14.9.png"
                    translation="[700, 608]" width="520" height="96" />
            <Label id="credsLabel"
                   translation="[700, 634]" width="520" horizAlign="center"
                   text="Sign in with username"
                   font="font:MediumBoldSystemFont" color="0x93A0B8FF" />

            <!-- Remembered / failed server (only shown when relevant) -->
            <Label id="savedUrl"
                   translation="[0, 726]" width="1920" horizAlign="center"
                   text="" font="font:SmallSystemFont" color="0x5B7BA8FF" />

            <Label id="setupHint"
                   translation="[0, 772]" width="1920" horizAlign="center"
                   text="Press OK to enter your server address"
                   font="font:SmallSystemFont" color="0x5B7BA8FF" />

            <Label id="setupError"
                   translation="[0, 818]" width="1920" horizAlign="center"
                   text="" font="font:SmallSystemFont" color="0xFF6B6BFF" />
        </Group>

        <!-- ═══ LOADING VIEW ═══ -->
        <Group id="loadingView" visible="false">
            <Label id="loadingLabel"
                   translation="[0, 512]" width="1920" horizAlign="center"
                   text="Connecting to your server…"
                   font="font:MediumSystemFont" color="0xCCD8EAFF" />
        </Group>

        <!-- ═══ PAIRING VIEW — link code ═══ -->
        <Group id="pairingView" visible="false">
            <Label translation="[0, 398]" width="1920" horizAlign="center"
                   text="1     Sign in to your server in a browser"
                   font="font:MediumSystemFont" color="0x9FB6D4FF" />
            <Label id="loginUrl"
                   translation="[0, 444]" width="1920" horizAlign="center"
                   text="" font="font:MediumBoldSystemFont" color="0x5AA9FFFF" />

            <Label translation="[0, 520]" width="1920" horizAlign="center"
                   text="2     Open /pair and enter this code"
                   font="font:MediumSystemFont" color="0x9FB6D4FF" />
            <Label id="pairUrl"
                   translation="[0, 562]" width="1920" horizAlign="center"
                   text="" font="font:SmallSystemFont" color="0x55557799" />

            <!-- Code card -->
            <Poster uri="pkg:/images/surface_r14.9.png" translation="[660, 618]" width="600" height="140" />
            <Label id="codeLabel"
                   translation="[660, 654]" width="600" horizAlign="center"
                   text="----  ----"
                   font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />

            <Label id="statusLabel"
                   translation="[0, 800]" width="1920" horizAlign="center"
                   text="Waiting for authorization…"
                   font="font:SmallSystemFont" color="0x7FA6D8FF" />
            <Label id="errorLabel"
                   translation="[0, 846]" width="1920" horizAlign="center"
                   text="" font="font:SmallSystemFont" color="0xFF6B6BFF" />

            <Label translation="[0, 992]" width="1920" horizAlign="center"
                   text="Press * (Options) to change server"
                   font="font:SmallSystemFont" color="0x3A4A66FF" />
        </Group>

    </children>
</component>
