<?xml version="1.0" encoding="UTF-8"?>
<component name="CategoryTile" extends="Group">
    <interface>
        <field id="itemContent"  type="node"  alwaysNotify="true" />
        <field id="focusPercent" type="float" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="bg"          color="0x0D1F38FF" width="400" height="225" />
        <Rectangle id="focusBorder" color="0x4A9FFFFF" width="404" height="229" translation="[-2,-2]" opacity="0" />
        <Poster    id="poster"       width="400" height="225" loadDisplayMode="scaleToZoom" opacity="0.62" />
        <Poster    id="cornerMask"  uri="pkg:/images/corner_cat.png" width="400" height="225" />
        <Rectangle id="gradient"    color="0x00000099" width="400" height="100" translation="[0,125]" />
        <Label     id="titleLabel"  translation="[18,158]" width="364" height="48"
                   font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/CategoryTile.brs" />
</component>
