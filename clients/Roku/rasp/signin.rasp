# Arctic Media - sign-in script for Roku App Behavior Analysis
#
# Drives the on-device credential path added in build 47, so the whole sign-in
# completes without a browser. Key sequence verified against a real device;
# the four Down presses are not padding — that is genuinely how far it is from
# the keyboard grid to the button row in StandardKeyboardDialog.
#
# Replace PASSWORD_HERE before uploading.
#
# Validate/record in the Roku Remote tool first:
# https://devtools.web.roku.com/RokuRemote/

params:
    rasp_version: 1
    default_keypress_wait: 2

steps:
    - launch: dev
    # Splash has an 800ms minimum, then the pairing screen renders.
    - pause: 8

    # If a server address is already stored the channel goes straight to the
    # browser-pairing code screen. Options (*) backs out to the chooser.
    # Harmless on a fresh device, where the chooser is already showing.
    - press: options
    - pause: 3

    # "Connect to Server" is selected by default; move down to
    # "Sign in with username".
    - press: down
    - press: ok
    - pause: 3

    # Username. On a fresh device the server address is asked for first — see
    # the note at the bottom.
    - text: RokuTest
    - pause: 1
    - press: down, down, down, down    # keyboard grid -> button row
    - press: ok                        # "Next"
    - pause: 3

    - text: PASSWORD_HERE
    - pause: 1
    - press: down, down, down, down
    - press: ok                        # "Sign In"

    # Token exchange, then the home screen loads its shelves.
    - pause: 15

# ---------------------------------------------------------------------------
# Fresh device note
#
# With no stored server address, choosing "Sign in with username" asks for the
# address before the username. Insert this block after the first `press: ok`:
#
#     - text: arcticmedia.space      # the field is prefilled with "https://"
#     - pause: 1
#     - press: down, down, down, down
#     - press: ok                    # "Connect"
#     - pause: 3
#
# Roku's certification devices are fresh, so that block is probably the one
# they need. Confirm which case applies by watching a factory-reset device, or
# supply both scripts and say which is which.
# ---------------------------------------------------------------------------
